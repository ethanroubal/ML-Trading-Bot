# Copy this file to ".env" and fill in what you need. Never share the .env file.
#
# 1) MARKET DATA (optional, free): https://alpaca.markets -> sign up -> API keys.
#    With these present the trader switches from Yahoo to Alpaca data automatically.
#    If these are PAPER-account keys they are also used for --broker alpaca-paper.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# 2) ALPACA PAPER TRADING (optional): only needed if the keys above are not paper-account keys.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# 3) ALPACA LIVE TRADING - REAL MONEY (optional). Used only by --broker alpaca-live, which
#    also needs "allow_live: true" in config.yaml and a typed confirmation at every start.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
